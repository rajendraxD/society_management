# Copy to .env and fill in real values. Never commit the .env file.

# ---- Server ----
NODE_ENV=development
PORT=5000

# ---- Database ----
# Local:  mongodb://localhost:27017/society_management
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/society_management
MONGODB_URI=mongodb://localhost:27017/society_management

# ---- CORS ----
# Comma-separated list of origins allowed to call the API. The server fails
# closed: an origin not listed here is rejected.
# Include your LAN IP while testing on a physical Android device, e.g.
# http://localhost:8100,http://192.168.1.5:8100,capacitor://localhost,https://localhost
CLIENT_URL=http://localhost:8100,http://localhost:4200,capacitor://localhost,https://localhost

# ---- Auth ----
# REQUIRED in production; the server refuses to start without them.
# Generate each with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

ACCESS_TOKEN_EXPIRES=15m
REFRESH_TOKEN_EXPIRES=7d
